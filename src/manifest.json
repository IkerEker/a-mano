{
  "manifestVersion": 5,
  "id": "com.amano.handlettering",
  "name": "A mano",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "amanoPanel",
      "label": { "default": "A mano" },
      "minimumSize": { "width": 260, "height": 380 },
      "maximumSize": { "width": 1200, "height": 4000 },
      "preferredDockedSize": { "width": 300, "height": 560 },
      "preferredFloatingSize": { "width": 320, "height": 600 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["chrome"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
